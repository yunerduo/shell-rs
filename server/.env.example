# 复制成 server/.env 后再填真实值；.env 已在 .gitignore 里，不要提交。
# 这些值只用于 docker compose；命令行 publish 用环境变量单独传。

# 命令行发布接口的管理员令牌，至少 24 个字符
SHELLAS_ADMIN_TOKEN=replace-with-a-random-token

# 首次启动创建的后台 owner；库里有管理员后不会覆盖
SHELLAS_ADMIN_USER=admin
SHELLAS_ADMIN_PASSWORD=replace-with-a-strong-password

# 可选：后台网页发布用的 minisign 私钥与口令。
# 私钥放在数据卷里，例如 server/data/update.key。
# 不配置时后台发布会提示缺少私钥，命令行 publish 不受影响。
# SHELLAS_MINISIGN_KEY=/data/update.key
# SHELLAS_MINISIGN_KEY_PASSWORD=

# 可选：登录失败锁定。用户与管理员各自计数，互不影响。
# SHELLAS_LOGIN_MAX_FAILURES=5
# SHELLAS_LOGIN_LOCK_MINUTES=15
